# Скопируйте в CONFIG_DIR (по умолчанию ./config) как .env и заполните.
# Секреты никогда не коммитятся.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (OpenAI-совместимый endpoint, напр. LiteLLM/OpenRouter)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Порог отправки (по умолчанию 7)
SCORE_THRESHOLD=
